#ifndef ByteOrder_h
#define ByteOrder_h

#include <stdint.h>
#include <codecvt>
#include <locale>
#include <iostream>

#ifdef __APPLE__
#   include <libkern/OSByteOrder.h>
#elif @HEADER_HAVE_BYTESWAP_H@ //HEADER_HAVE_BYTESWAP_H
#   include <byteswap.h>
#endif

#if @HEADER_HAVE_ENDIAN_H@ //HEADER_HAVE_ENDIAN_H
#   include <endian.h>
#endif

#if @HEADER_HAVE_ARPA_INET_H@ //HEADER_HAVE_ARPA_INET_H
#   include <arpa/inet.h>
#elif @HEADER_HAVE_WINSOCK_H@ //HEADER_HAVE_WINSOCK_H
#   define MAYBE_CONSTEXPR inline
#   include <winsock.h>
#   include <sys/param.h>
#endif

#ifndef MAYBE_CONSTEXPR
#   define MAYBE_CONSTEXPR constexpr inline
#endif

#ifdef __APPLE__
MAYBE_CONSTEXPR bool isBigEndianSystem(){
#   if __DARWIN_BYTE_ORDER == __DARWIN_BIG_ENDIAN
    return true;
#   else
    return false;
#   endif
}
#elif defined(BYTE_ORDER)
MAYBE_CONSTEXPR bool isBigEndianSystem(){
#   if BYTE_ORDER == BIG_ENDIAN
    return true;
#   else
    return false;
#   endif
}
#else
#error can't determine byteorder for system
#endif

template <typename T>
inline T byteOrder_HTOBE(T num);

template <typename T>
inline T byteOrder_HTOLE(T num);

#pragma mark implementation BE
template<>
MAYBE_CONSTEXPR uint8_t byteOrder_HTOBE<uint8_t>(uint8_t num){
    return num;
}

template<>
MAYBE_CONSTEXPR int8_t byteOrder_HTOBE<int8_t>(int8_t num){
    return num;
}

template<>
inline uint16_t byteOrder_HTOBE<uint16_t>(uint16_t num){
#if @HAVE_DECL_HTONS@ //HAVE_DECL_HTONS
    return htons(num);
#else
    return isBigEndianSystem() ? num : __builtin_bswap16(num);
#endif
}

template<>
inline int16_t byteOrder_HTOBE<int16_t>(int16_t num){
#if @HAVE_DECL_HTONS@ //HAVE_DECL_HTONS
    return htons(num);
#else
    return isBigEndianSystem() ? num : __builtin_bswap16(num);
#endif
}

template<>
inline uint32_t byteOrder_HTOBE<uint32_t>(uint32_t num){
#if @HAVE_DECL_HTONL@ //HAVE_DECL_HTONL
    return htonl(num);
#else
    return isBigEndianSystem() ? num : __builtin_bswap32(num);
#endif
}

template<>
inline int32_t byteOrder_HTOBE<int32_t>(int32_t num){
#if @HAVE_DECL_HTONL@ //HAVE_DECL_HTONL
    return htonl(num);
#else
    return isBigEndianSystem() ? num : __builtin_bswap32(num);
#endif
}

template<>
inline uint64_t byteOrder_HTOBE<uint64_t>(uint64_t num){
#if @HAVE_DECL_HTONLL@ //HAVE_DECL_HTONLL
    return htonll(num);
#else
    return isBigEndianSystem() ? num : __builtin_bswap64(num);
#endif
}

template<>
inline int64_t byteOrder_HTOBE<int64_t>(int64_t num){
#if @HAVE_DECL_HTONLL@ //HAVE_DECL_HTONLL
    return htonll(num);
#else
    return isBigEndianSystem() ? num : __builtin_bswap64(num);
#endif
}

#pragma mark implementation LE
template<>
MAYBE_CONSTEXPR uint8_t byteOrder_HTOLE<uint8_t>(uint8_t num){
    return num;
}

template<>
MAYBE_CONSTEXPR int8_t byteOrder_HTOLE<int8_t>(int8_t num){
    return num;
}

template<>
inline uint16_t byteOrder_HTOLE<uint16_t>(uint16_t num){
#if @HAVE_DECL_HTOLE16@ //HAVE_DECL_HTOLE16
    return htole16(num);
#else
    return !isBigEndianSystem() ? num : __builtin_bswap16(num);
#endif
}

template<>
inline int16_t byteOrder_HTOLE<int16_t>(int16_t num){
#if @HAVE_DECL_HTOLE16@ //HAVE_DECL_HTOLE16
    return htole16((uint16_t)num);
#else
    return !isBigEndianSystem() ? num : __builtin_bswap16(num);
#endif
}

template<>
inline uint32_t byteOrder_HTOLE<uint32_t>(uint32_t num){
#if @HAVE_DECL_HTOLE32@ //HAVE_DECL_HTOLE32
    return htole32(num);
#else
    return !isBigEndianSystem() ? num : __builtin_bswap32(num);
#endif
}

template<>
inline int32_t byteOrder_HTOLE<int32_t>(int32_t num){
#if @HAVE_DECL_HTOLE32@ //HAVE_DECL_HTOLE32
    return htole32((uint32_t)num);
#else
    return !isBigEndianSystem() ? num : __builtin_bswap32(num);
#endif
}

template<>
inline uint64_t byteOrder_HTOLE<uint64_t>(uint64_t num){
#if @HAVE_DECL_HTOLE64@ //HAVE_DECL_HTOLE64
    return htole64(num);
#else
    return !isBigEndianSystem() ? num : __builtin_bswap64(num);
#endif
}

template<>
inline int64_t byteOrder_HTOLE<int64_t>(int64_t num){
#if @HAVE_DECL_HTOLE64@ //HAVE_DECL_HTOLE64
    return htole64((uint64_t)num);
#else
    return !isBigEndianSystem() ? num : __builtin_bswap64(num);
#endif
}

#define cnvHTOBE(x) byteOrder_HTOBE(x)
#define cnvBETOH(x) byteOrder_HTOBE(x)
#define cnvHTOLE(x) byteOrder_HTOLE(x)
#define cnvLETOH(x) byteOrder_HTOLE(x)

#pragma mark UTF-16
inline std::wstring strToWstr(const char *s){
    std::wstring_convert<std::codecvt_utf8_utf16<wchar_t>> converter;
    return converter.from_bytes(s);
}

inline std::wstring strToWstr(std::string s){
    std::wstring_convert<std::codecvt_utf8_utf16<wchar_t>> converter;
    return converter.from_bytes(s);
}

inline std::string wstrToStr(const std::wstring& str){
    std::wstring_convert<std::codecvt_utf8<wchar_t>> myconv;
    return myconv.to_bytes(str);
}

#pragma mark UTF-32
inline std::u32string strToW32str(const char *s){
    std::wstring_convert<std::codecvt_utf8<char32_t>,char32_t> converter;
    return converter.from_bytes(s);
}

inline std::u32string strToW32str(std::string s){
    std::wstring_convert<std::codecvt_utf8<char32_t>,char32_t> converter;
    return converter.from_bytes(s);
}

inline std::string w32strToStr(const std::u32string& str){
    std::wstring_convert<std::codecvt_utf8<char32_t>,char32_t> myconv;
    return myconv.to_bytes(str);
}

#endif /* ByteOrder_h */
